expression ProjectFolder = "C:\Users\Kamal\Desktop\project\workforce-analytics" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: b2a11454-afd4-510e-9ed0-4278340724bd

	annotation PBI_ResultType = Text

expression fnParseDate =
		// fnParseDate - turns "2025-11-30" (ISO) or "30.11.2025" (German export) into a date.
		// Blank text stays blank. One function, reused by every query that reads dates, so
		// the rule for "what counts as a valid date" is written down exactly once.
		(value as nullable text) as nullable date =>
		let
		    t = if value = null then "" else Text.Trim(value),
		    iso = try Date.FromText(t, [Format = "yyyy-MM-dd", Culture = "en-US"]) otherwise null,
		    german = try Date.FromText(t, [Format = "dd.MM.yyyy", Culture = "de-DE"]) otherwise null,
		    result = if t = "" then null else if iso <> null then iso else german
		in
		    result
	lineageTag: 15ff3132-81d9-5c5a-a193-68e4250fd0bf

	annotation PBI_ResultType = Function

expression FX =
		// FX - ECB monthly average rates (real data): how many CZK / GBP / EUR one euro buys.
		// Staging only: right-click > uncheck "Enable load"; Snapshot merges it in.
		let
		    Source = Csv.Document(
		        File.Contents(ProjectFolder & "\data\external\fx_rates_monthly.csv"),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    // The culture argument "en-US" makes "24.2965" parse correctly on a Czech or German PC,
		    // where the decimal separator is a comma.
		    Typed = Table.TransformColumnTypes(Promoted, {
		        {"Month", type text}, {"Currency", type text}, {"Units per EUR", type number}
		    }, "en-US")
		in
		    Typed
	lineageTag: 1f74fe8b-36ce-579b-b298-784d7220b4d0

	annotation PBI_ResultType = Table

expression TerminationReasons =
		// TerminationReasons - lookup: Event Reason -> Voluntary / Involuntary / Retirement.
		// Keeping this mapping in a table (not in an IF formula) means HR can change it without
		// touching the logic. Staging only: uncheck "Enable load".
		let
		    Source = Csv.Document(
		        File.Contents(ProjectFolder & "\data\reference\termination_reasons.csv"),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(Promoted, {
		        {"Event Reason", type text}, {"Leaver Category", type text}, {"Is Voluntary", type text}, {"Reason Short", type text}
		    }),
		    AsLogical = Table.TransformColumns(Typed, {{"Is Voluntary", each _ = "Yes", type logical}})
		in
		    AsLogical
	lineageTag: e4095ce6-17c7-5c16-ad42-24939b9cfae7

	annotation PBI_ResultType = Table

expression Exports_Raw =
		// Exports_Raw - every monthly export in the folder, stacked into one table, untouched.
		// This is the automation: drop next month's file into data\exports, press Refresh, done.
		// Everything stays as text here on purpose - the data-quality rules need to see the raw values.
		// Staging only: uncheck "Enable load".
		let
		    ExportColumns = {
		        "Person ID External", "First Name", "Last Name", "Gender", "Employee Status",
		        "Employee Class", "Hire Date", "Event", "Event Reason", "Event Date",
		        "Regret Termination", "Division", "Department", "Cost Center", "Legal Entity",
		        "Location", "Job Title", "Pay Grade", "FTE", "Manager ID", "Annual Salary", "Currency"
		    },
		    Source = Folder.Files(ProjectFolder & "\data\exports"),
		    // Only month files named like 2025-07.csv (11 characters)
		    MonthFiles = Table.SelectRows(Source, each [Extension] = ".csv" and Text.Length([Name]) = 11),
		    // The file name says which month-end the snapshot describes
		    AddAsOf = Table.AddColumn(MonthFiles, "As Of", each Date.EndOfMonth(#date(
		        Number.FromText(Text.Start([Name], 4)), Number.FromText(Text.Middle([Name], 5, 2)), 1)), type date),
		    // Encoding 65001 = UTF-8, so Czech names like "Čermáková" survive
		    AddData = Table.AddColumn(AddAsOf, "Data", each Table.PromoteHeaders(
		        Csv.Document([Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		        [PromoteAllScalars = true])),
		    KeepCols = Table.SelectColumns(AddData, {"Name", "As Of", "Data"}),
		    Expanded = Table.ExpandTableColumn(KeepCols, "Data", ExportColumns),
		    Renamed = Table.RenameColumns(Expanded, {{"Name", "File"}}),
		    Sorted = Table.Sort(Renamed, {{"File", Order.Ascending}}),
		    WithRowId = Table.AddIndexColumn(Sorted, "Row ID", 1, 1, Int64.Type)
		in
		    WithRowId
	lineageTag: 5ca1528b-870d-5168-a2cc-781ac1b8a2af

	annotation PBI_ResultType = Table
