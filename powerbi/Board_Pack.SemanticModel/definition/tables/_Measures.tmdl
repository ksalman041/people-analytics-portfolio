	measure 'Headcount Other Entities' = [Headcount] - [Headcount Prague]
		formatString: #,0
		isHidden
		displayFolder: Workforce
		lineageTag: f79aee42-53fa-58b4-b245-521c9a3b4a87

	/// Employees who joined in the 12 months up to the selected month (found by comparing month-end snapshots).
	measure 'Hires R12' =
			VAR _m = MAX ( DimDate[Month End] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( Movements ),
			        Movements[Movement] = "Hire",
			        REMOVEFILTERS ( DimDate ),
			        DimDate[Month End] > EOMONTH ( _m, -12 ),
			        DimDate[Month End] <= _m
			    )
		formatString: #,0
		displayFolder: Movement
		lineageTag: 1a519fc5-95ac-5024-9eb0-259f49672d87

	measure 'Hires R12 PY' =
			CALCULATE (
			    [Hires R12],
			    REMOVEFILTERS ( DimDate ),
			    DimDate[Month End] = EOMONTH ( MAX ( DimDate[Month End] ), -12 )
			)
		formatString: #,0
		isHidden
		displayFolder: Movement
		lineageTag: 1fc46362-bd30-591a-af6a-c9a281cbddb6

	/// Employees who left in the 12 months up to the selected month (found by comparing month-end snapshots).
	measure 'Leavers R12' =
			VAR _m = MAX ( DimDate[Month End] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( Movements ),
			        Movements[Movement] = "Leaver",
			        REMOVEFILTERS ( DimDate ),
			        DimDate[Month End] > EOMONTH ( _m, -12 ),
			        DimDate[Month End] <= _m
			    )
		formatString: #,0
		displayFolder: Movement
		lineageTag: 8dba7656-3f36-56e9-995b-bb495b345c0f

	measure 'Transfers In R12' =
			VAR _m = MAX ( DimDate[Month End] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( Movements ),
			        Movements[Movement] = "Transfer In",
			        REMOVEFILTERS ( DimDate ),
			        DimDate[Month End] > EOMONTH ( _m, -12 ),
			        DimDate[Month End] <= _m
			    )
		formatString: #,0
		isHidden
		displayFolder: Movement
		lineageTag: ba79804d-456a-5859-8836-fb8e63153e57

	measure 'Transfers Out R12' =
			VAR _m = MAX ( DimDate[Month End] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( Movements ),
			        Movements[Movement] = "Transfer Out",
			        REMOVEFILTERS ( DimDate ),
			        DimDate[Month End] > EOMONTH ( _m, -12 ),
			        DimDate[Month End] <= _m
			    )
		formatString: #,0
		isHidden
		displayFolder: Movement
		lineageTag: f8cdb211-9a21-5592-be4a-c8dcb56da3fa

	measure 'Avg Headcount R12' =
			VAR _m = MAX ( DimDate[Month End] )
			VAR _months = CALCULATETABLE ( VALUES ( DimDate[Month End] ), REMOVEFILTERS ( DimDate ), DimDate[Month End] > EOMONTH ( _m, -12 ), DimDate[Month End] <= _m )
			RETURN
			    AVERAGEX (
			        _months,
			        VAR _d = DimDate[Month End]
			        RETURN CALCULATE ( COUNTROWS ( Snapshot ), Snapshot[Is Headcount] = TRUE (), REMOVEFILTERS ( DimDate ), DimDate[Month End] = _d ) + 0
			    )
		formatString: #,0.0
		isHidden
		displayFolder: Movement
		lineageTag: 6fa8a503-b814-5f03-a6ed-58883302ef0a

	/// Leavers in the last 12 months divided by the average of the 12 month-end headcounts. Hidden below 5 people.
	measure 'Turnover R12 %' =
			VAR _avg = [Avg Headcount R12]
			RETURN IF ( [Has Full Year] && _avg >= 5, DIVIDE ( [Leavers R12] + 0, _avg ) )
		formatString: 0.0%
		displayFolder: Movement
		lineageTag: a9ffb2d2-5370-52b3-931b-339e117975ae

	/// Resignations in the last 12 months divided by the average month-end headcount. Hidden below 5 people.
	measure 'Voluntary Turnover R12 %' =
			VAR _avg = [Avg Headcount R12]
			VAR _vol = CALCULATE ( [Leavers R12], Movements[Leaver Category] = "Voluntary" )
			RETURN IF ( [Has Full Year] && _avg >= 5, DIVIDE ( _vol + 0, _avg ) )
		formatString: 0.0%
		displayFolder: Movement
		lineageTag: 058294d0-d96b-579e-8031-9baae6e5b016

	measure 'Turnover R12 % PY' =
			CALCULATE (
			    [Turnover R12 %],
			    REMOVEFILTERS ( DimDate ),
			    DimDate[Month End] = EOMONTH ( MAX ( DimDate[Month End] ), -12 )
			)
		formatString: 0.0%
		isHidden
		displayFolder: Movement
		lineageTag: 3e77f4ea-d506-508f-bb15-0fc37b012553

	measure 'Voluntary Turnover R12 % PY' =
			CALCULATE (
			    [Voluntary Turnover R12 %],
			    REMOVEFILTERS ( DimDate ),
			    DimDate[Month End] = EOMONTH ( MAX ( DimDate[Month End] ), -12 )
			)
		formatString: 0.0%
