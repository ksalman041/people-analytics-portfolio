	measure 'Delta Headcount' =
			VAR _c = [Headcount]
			VAR _p = [Headcount PY]
			VAR _r = ROUND ( _c - _p, 0 )
			VAR _arrow = IF ( _r > 0, "▲ +", IF ( _r < 0, "▼ −", "► ±" ) )
			RETURN
			    IF (
			        ISBLANK ( _c ) || ISBLANK ( _p ),
			        BLANK (),
			        _arrow & FORMAT ( ABS ( _r ), "0" ) & "   vs " & FORMAT ( [PY Month], "mmm yyyy" )
			    )
		isHidden
		displayFolder: Tiles
		lineageTag: de229bac-533a-5ef8-a716-34a1f22cbad0

	measure 'Color Delta Headcount' = "#52514E"
		isHidden
		displayFolder: Tiles
		lineageTag: bd45301a-3eff-54c3-acb2-0c6e6abef0e4

	measure 'Delta Hires' =
			VAR _c = [Hires R12]
			VAR _p = [Hires R12 PY]
			VAR _r = ROUND ( _c - _p, 0 )
			VAR _arrow = IF ( _r > 0, "▲ +", IF ( _r < 0, "▼ −", "► ±" ) )
			RETURN
