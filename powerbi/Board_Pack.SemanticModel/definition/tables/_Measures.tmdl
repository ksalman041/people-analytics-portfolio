	measure 'Delta Turnover' =
			VAR _c = [Turnover R12 %]
			VAR _p = [Turnover R12 % PY]
			VAR _r = ROUND ( ( _c - _p ) * 100, 1 )
			VAR _arrow = IF ( _r > 0, "▲ +", IF ( _r < 0, "▼ −", "► ±" ) )
			RETURN
			    IF (
			        ISBLANK ( _c ) || ISBLANK ( _p ),
			        BLANK (),
			        _arrow & FORMAT ( ABS ( _r ), "0.0" ) & " pp   vs " & FORMAT ( [PY Month], "mmm yyyy" )
			    )
		isHidden
		displayFolder: Tiles
		lineageTag: ad72dda7-18a5-51b7-b3fc-4616f8499689

	measure 'Color Delta Turnover' =
			VAR _c = [Turnover R12 %]
			VAR _p = [Turnover R12 % PY]
			VAR _d = ( _c - _p ) * 100
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _c ) || ISBLANK ( _p ), "#52514E",
			        NOT ( ABS ( _d ) >= 0.5 ), "#52514E",
			        _d < 0, "#006300",
			        "#D03B3B"
			    )
		isHidden
		displayFolder: Tiles
		lineageTag: 66859a59-33f1-51bf-b1fb-7ead127e2942

	measure 'Delta Voluntary Turnover' =
			VAR _c = [Voluntary Turnover R12 %]
			VAR _p = [Voluntary Turnover R12 % PY]
			VAR _r = ROUND ( ( _c - _p ) * 100, 1 )
			VAR _arrow = IF ( _r > 0, "▲ +", IF ( _r < 0, "▼ −", "► ±" ) )
			RETURN
			    IF (
			        ISBLANK ( _c ) || ISBLANK ( _p ),
			        BLANK (),
			        _arrow & FORMAT ( ABS ( _r ), "0.0" ) & " pp   vs " & FORMAT ( [PY Month], "mmm yyyy" )
			    )
		isHidden
		displayFolder: Tiles
		lineageTag: b0162f17-0544-5837-87ef-53184e7c29f3

	measure 'Color Delta Voluntary Turnover' =
			VAR _c = [Voluntary Turnover R12 %]
			VAR _p = [Voluntary Turnover R12 % PY]
			VAR _d = ( _c - _p ) * 100
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _c ) || ISBLANK ( _p ), "#52514E",
			        NOT ( ABS ( _d ) >= 0.5 ), "#52514E",
			        _d < 0, "#006300",
			        "#D03B3B"
			    )
		isHidden
		displayFolder: Tiles
		lineageTag: bc1c67c9-05df-5cb1-a49e-398c2947a04f

	measure 'Delta Women in Leadership' =
			VAR _c = [Women in Leadership %]
			VAR _p = [Women in Leadership % PY]
			VAR _r = ROUND ( ( _c - _p ) * 100, 1 )
			VAR _arrow = IF ( _r > 0, "▲ +", IF ( _r < 0, "▼ −", "► ±" ) )
			RETURN
			    IF (
			        ISBLANK ( _c ) || ISBLANK ( _p ),
			        BLANK (),
			        _arrow & FORMAT ( ABS ( _r ), "0.0" ) & " pp   vs " & FORMAT ( [PY Month], "mmm yyyy" )
			    )
		isHidden
		displayFolder: Tiles
		lineageTag: 2d7da0d4-ccf3-5daa-a08c-a9372dce95fa

