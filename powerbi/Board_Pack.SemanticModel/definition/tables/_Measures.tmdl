	measure 'Turnover R12 % Company' = CALCULATE ( [Turnover R12 %], REMOVEFILTERS ( DimDivision ) )
		formatString: 0.0%
		displayFolder: Movement
		lineageTag: fe834fe6-1cd4-5637-ba21-1277874c6784

	measure 'Turnover R12 % Operations' = CALCULATE ( [Turnover R12 %], DimDivision[Division] = "Operations" )
		formatString: 0.0%
		displayFolder: Movement
		lineageTag: b13268bd-f714-53c3-ae9d-6cc3dc3c9d8d

	/// Share of the last 12 months' leavers who left within 12 months of joining. Hidden below 5 leavers.
	measure 'Early Leavers R12 %' =
			VAR _l = [Leavers R12]
			VAR _e = CALCULATE ( [Leavers R12], Movements[Is Early Leaver] = TRUE () )
			RETURN IF ( [Has Full Year] && _l >= 5, DIVIDE ( _e + 0, _l ) )
		formatString: 0.0%
		displayFolder: Movement
		lineageTag: da602504-870e-5187-bd6f-6828967d8108

	measure 'Bridge Value' =
			SWITCH (
			    SELECTEDVALUE ( BridgeSteps[Step] ),
			    "Opening", [Headcount PY],
			    "Hires", [Hires R12] + 0,
			    "Voluntary leavers", - ( CALCULATE ( [Leavers R12], Movements[Leaver Category] = "Voluntary" ) + 0 ),
			    "Involuntary leavers", - ( CALCULATE ( [Leavers R12], Movements[Leaver Category] = "Involuntary" ) + 0 ),
			    "Retirements", - ( CALCULATE ( [Leavers R12], Movements[Leaver Category] = "Retirement" ) + 0 ),
			    "Net transfers", [Transfers In R12] + 0 - ( [Transfers Out R12] + 0 )
			)
		displayFolder: Movement
		lineageTag: 801f57a0-ba81-5ef8-ad69-54248ae56e1b
		formatStringDefinition = IF ( SELECTEDVALUE ( BridgeSteps[Step] ) IN { "Opening" } || NOT HASONEVALUE ( BridgeSteps[Step] ), "#,0", "+#,0;-#,0;0" )

	/// Women as a share of headcount at month-end.
	measure 'Women %' =
			VAR _hc = [Headcount]
			RETURN IF ( _hc >= 5, DIVIDE ( CALCULATE ( [Headcount], Snapshot[Gender] = "Female" ) + 0, _hc ) )
		formatString: 0.0%
		displayFolder: Diversity & Pay
		lineageTag: 588c048b-71ab-522a-b0c8-5e50cce03993

	measure 'Women % PY' =
			CALCULATE (
			    [Women %],
			    REMOVEFILTERS ( DimDate ),
			    DimDate[Month End] = EOMONTH ( MAX ( DimDate[Month End] ), -12 )
			)
		formatString: 0.0%
		isHidden
		displayFolder: Diversity & Pay
		lineageTag: d530004f-b61b-5e78-a43f-4766801a1e09

	/// Women as a share of grades G6-G7 at month-end. Hidden below 5 people.
	measure 'Women in Leadership %' =
			VAR _lead = CALCULATE ( [Headcount], Snapshot[Is Leadership] = TRUE () )
			RETURN IF ( _lead >= 5, DIVIDE ( CALCULATE ( [Headcount], Snapshot[Is Leadership] = TRUE (), Snapshot[Gender] = "Female" ) + 0, _lead ) )
		formatString: 0.0%
		displayFolder: Diversity & Pay
		lineageTag: fceba6aa-c37f-5b14-af34-77e361fc8457

	measure 'Women in Leadership % PY' =
			CALCULATE (
			    [Women in Leadership %],
			    REMOVEFILTERS ( DimDate ),
			    DimDate[Month End] = EOMONTH ( MAX ( DimDate[Month End] ), -12 )
			)
		formatString: 0.0%
		isHidden
		displayFolder: Diversity & Pay
		lineageTag: dfcd3257-3fa8-5d4d-821c-64c48e9d9398

	measure Women =
			VAR _f = CALCULATE ( [Headcount], Snapshot[Gender] = "Female" ) + 0
			VAR _m = CALCULATE ( [Headcount], Snapshot[Gender] = "Male" ) + 0
			RETURN IF ( _f + _m >= 5, DIVIDE ( _f, _f + _m ) )
		formatString: 0%
		displayFolder: Diversity & Pay
		lineageTag: 7f70d85b-6de2-5d1c-a3f6-544297c54c8d

	measure Men =
			VAR _f = CALCULATE ( [Headcount], Snapshot[Gender] = "Female" ) + 0
			VAR _m = CALCULATE ( [Headcount], Snapshot[Gender] = "Male" ) + 0
			RETURN IF ( _f + _m >= 5, DIVIDE ( _m, _f + _m ) )
		formatString: 0%
		displayFolder: Diversity & Pay
		lineageTag: adad0eaa-3a9d-5388-b59a-fbff5f7682a0

	/// (Men's mean - women's mean FTE salary in EUR) / men's mean. Needs at least 5 women and 5 men.
	measure 'Pay Gap Mean %' =
			VAR _m = MAX ( DimDate[Month End] )
			VAR _pay = CALCULATETABLE ( Snapshot, Snapshot[Pay Valid] = TRUE (), REMOVEFILTERS ( DimDate ), DimDate[Month End] = _m )
			VAR _men = FILTER ( _pay, Snapshot[Gender] = "Male" )
			VAR _women = FILTER ( _pay, Snapshot[Gender] = "Female" )
			VAR _am = AVERAGEX ( _men, Snapshot[Salary FTE EUR] )
			VAR _aw = AVERAGEX ( _women, Snapshot[Salary FTE EUR] )
			RETURN IF ( COUNTROWS ( _men ) >= 5 && COUNTROWS ( _women ) >= 5, DIVIDE ( _am - _aw, _am ) )
		formatString: 0.0%
		displayFolder: Diversity & Pay
		lineageTag: 14b84f90-b36e-5cbd-ae76-b0526afbfa55

	/// (Men's median - women's median FTE salary in EUR) / men's median. Needs at least 5 women and 5 men.
	measure 'Pay Gap Median %' =
			VAR _m = MAX ( DimDate[Month End] )
			VAR _pay = CALCULATETABLE ( Snapshot, Snapshot[Pay Valid] = TRUE (), REMOVEFILTERS ( DimDate ), DimDate[Month End] = _m )
			VAR _men = FILTER ( _pay, Snapshot[Gender] = "Male" )
			VAR _women = FILTER ( _pay, Snapshot[Gender] = "Female" )
			VAR _am = MEDIANX ( _men, Snapshot[Salary FTE EUR] )
			VAR _aw = MEDIANX ( _women, Snapshot[Salary FTE EUR] )
			RETURN IF ( COUNTROWS ( _men ) >= 5 && COUNTROWS ( _women ) >= 5, DIVIDE ( _am - _aw, _am ) )
		formatString: 0.0%
		displayFolder: Diversity & Pay
		lineageTag: d6a5f517-d714-5a30-88e3-88a95c4b1a98

	measure 'Pay Gap Mean % PY' =
			CALCULATE (
			    [Pay Gap Mean %],
			    REMOVEFILTERS ( DimDate ),
			    DimDate[Month End] = EOMONTH ( MAX ( DimDate[Month End] ), -12 )
			)
		formatString: 0.0%
		isHidden
		displayFolder: Diversity & Pay
		lineageTag: 26558d25-899a-575b-89c2-a8ae1fcad357

	/// Mean gap inside each legal entity x grade group (5+ women and 5+ men), weighted by group size.
	measure 'Pay Gap Like-for-like %' =
			VAR _m = MAX ( DimDate[Month End] )
			VAR _groups = CALCULATETABLE ( SUMMARIZE ( Snapshot, Snapshot[Legal Entity], Snapshot[Grade] ), Snapshot[Pay Valid] = TRUE (), REMOVEFILTERS ( DimDate ), DimDate[Month End] = _m )
			VAR _t =
			    ADDCOLUMNS (
			        _groups,
			        "@gap", CALCULATE ( [Pay Gap Mean %] ),
			        "@n", CALCULATE ( COUNTROWS ( Snapshot ), Snapshot[Pay Valid] = TRUE (), REMOVEFILTERS ( DimDate ), DimDate[Month End] = _m )
			    )
			VAR _valid = FILTER ( _t, NOT ISBLANK ( [@gap] ) )
			RETURN DIVIDE ( SUMX ( _valid, [@gap] * [@n] ), SUMX ( _valid, [@n] ) )
		formatString: 0.0%
		displayFolder: Diversity & Pay
		lineageTag: 6be0a9a5-15b7-5817-a09d-e1bc5485b097

	measure 'Pay Gap Like-for-like % PY' =
			CALCULATE (
			    [Pay Gap Like-for-like %],
			    REMOVEFILTERS ( DimDate ),
			    DimDate[Month End] = EOMONTH ( MAX ( DimDate[Month End] ), -12 )
			)
		formatString: 0.0%
		isHidden
		displayFolder: Diversity & Pay
		lineageTag: 37ba04a7-5030-5fa7-a5a6-0ec45a07e50e

	/// Eurostat earn_gr_gpgr2: raw gender pay gap, financial & insurance sector, entity's country, latest year.
	measure 'Sector Benchmark %' =
			VAR _c = SELECTEDVALUE ( LegalEntities[Country] )
			VAR _y = CALCULATE ( MAX ( Eurostat_GPG[Year] ), Eurostat_GPG[Geo] = _c, Eurostat_GPG[Activity] = "Financial & insurance" )
			RETURN DIVIDE ( CALCULATE ( MAX ( Eurostat_GPG[Pay Gap %] ), Eurostat_GPG[Geo] = _c, Eurostat_GPG[Activity] = "Financial & insurance", Eurostat_GPG[Year] = _y ), 100 )
		formatString: 0.0%
		displayFolder: Diversity & Pay
		lineageTag: cbb3ddd5-fc81-51be-9808-354d60371ea3

	measure 'Like-for-like Cell' =
			VAR _g = SELECTEDVALUE ( Snapshot[Pay Grade] )
			VAR _v = [Pay Gap Mean %]
			RETURN
			    IF (
			        ISBLANK ( _g ) || _g = "",
			        BLANK (),
			        IF ( ISBLANK ( _v ), "—", IF ( _v >= 0.05, "▲ ", "" ) & FORMAT ( _v, "0.0%" ) )
			    )
		displayFolder: Diversity & Pay
		lineageTag: 0a5e7263-55af-541c-b30c-5aee2b4ef8b0

	/// Data-quality rule hits (DQ01-DQ08) across all monthly files.
	measure 'Rule Exceptions' = COUNTROWS ( DQ_Exceptions ) + 0
