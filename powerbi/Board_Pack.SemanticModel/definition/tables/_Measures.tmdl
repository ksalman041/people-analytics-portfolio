table _Measures
	lineageTag: 70e84f59-d74a-584b-93a4-d30f024de9f8

	measure 'Latest Month' = MAX ( DimDate[Month End] )
		formatString: mmm yyyy
		displayFolder: Helpers
		lineageTag: fb77f459-bde3-502d-bd21-d96e48127cd7

	measure 'PY Month' = EOMONTH ( MAX ( DimDate[Month End] ), -12 )
		formatString: mmm yyyy
		isHidden
		displayFolder: Helpers
		lineageTag: 41260b85-14b0-5263-8740-48d1428fa67b

	measure 'Has Full Year' =
			VAR _m = MAX ( DimDate[Month End] )
			RETURN CALCULATE ( COUNTROWS ( DimDate ), REMOVEFILTERS ( DimDate ), DimDate[Month End] <= _m ) >= 13
		isHidden
		displayFolder: Helpers
		lineageTag: fb8bcf1e-7bd4-553d-ad00-b07ba3525d18

	measure 'Report Subtitle' = "Vltava Market Group  ·  " & FORMAT ( [Latest Month], "mmmm yyyy" ) & "  ·  synthetic data"
		displayFolder: Helpers
		lineageTag: cdef1635-f27c-531e-b515-d6691ea32293

	/// Employees on the last day of the month: status Active, not External, effective on or before month-end.
	measure Headcount =
			VAR _m = MAX ( DimDate[Month End] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( Snapshot ),
			        Snapshot[Is Headcount] = TRUE (),
			        REMOVEFILTERS ( DimDate ),
			        DimDate[Month End] = _m
			    )
		formatString: #,0
		displayFolder: Workforce
		lineageTag: 16963a46-7760-58d2-b2c2-88821035f679

	measure 'Headcount PY' =
			CALCULATE (
			    [Headcount],
			    REMOVEFILTERS ( DimDate ),
			    DimDate[Month End] = EOMONTH ( MAX ( DimDate[Month End] ), -12 )
			)
		formatString: #,0
		displayFolder: Workforce
		lineageTag: fc5f1459-300e-54a5-9040-de3cc8f69498

	/// Contracted capacity in full-time equivalents at month-end; FTE outside 0-1 is treated as missing.
	measure FTE =
			VAR _m = MAX ( DimDate[Month End] )
			RETURN CALCULATE ( SUM ( Snapshot[FTE] ), Snapshot[Is Headcount] = TRUE (), REMOVEFILTERS ( DimDate ), DimDate[Month End] = _m )
		formatString: #,0.0
		displayFolder: Workforce
		lineageTag: c10872c2-c173-5202-8952-1be615e9ad56

	measure 'Headcount Prague' = CALCULATE ( [Headcount], LegalEntities[Location] = "Prague" )
		formatString: #,0
		isHidden
		displayFolder: Workforce
		lineageTag: c76ff78b-b72b-584e-b32f-03b2f72ca153

	measure 'Headcount Frankfurt' = CALCULATE ( [Headcount], LegalEntities[Location] = "Frankfurt" )
		formatString: #,0
		isHidden
		displayFolder: Workforce
		lineageTag: 015f0a14-e0c9-5691-958a-87dc157bb3f7

	measure 'Headcount Luxembourg' = CALCULATE ( [Headcount], LegalEntities[Location] = "Luxembourg" )
		formatString: #,0
		isHidden
		displayFolder: Workforce
		lineageTag: e8840b81-9d55-5c95-be62-b85325411aff

	measure 'Headcount London' = CALCULATE ( [Headcount], LegalEntities[Location] = "London" )
		formatString: #,0
