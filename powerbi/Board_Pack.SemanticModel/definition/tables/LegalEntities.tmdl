table LegalEntities
	lineageTag: 72d6ebd9-bd5e-5735-b0ec-a5c2a70bbe78

	column 'Legal Entity'
		dataType: string
		lineageTag: 3b273680-c834-5b86-868d-e0973d815d55
		summarizeBy: none
		sourceColumn: Legal Entity

	column 'Entity Code'
		dataType: string
		lineageTag: 6ee7b18b-ad9b-505a-ad32-a536f43f5a67
		summarizeBy: none
		sourceColumn: Entity Code

	column Country
		dataType: string
		lineageTag: 8d2e2fab-6be1-5cdb-a138-0abb7c80e040
		summarizeBy: none
