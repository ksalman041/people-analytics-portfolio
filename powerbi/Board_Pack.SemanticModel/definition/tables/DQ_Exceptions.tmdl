		lineageTag: 2c088ad2-57cd-561a-afbf-257410d6a010
		summarizeBy: none
		sourceColumn: Rule

	column 'Rule Label'
		dataType: string
		lineageTag: 37cf0840-b055-535b-8a67-60fdaa532fd2
