table DQ_Exceptions
	lineageTag: b5f6f6f1-7161-56c9-8eb0-df1af9b23e76

	column File
		dataType: string
		lineageTag: a45d132d-a63f-5f1d-ab5f-63ce83fd1ede
		summarizeBy: none
		sourceColumn: File

	column 'As Of'
		dataType: dateTime
		formatString: yyyy-mm-dd
		isHidden
		lineageTag: 569b22bb-9971-5c6a-8413-762a0618fe2e
		summarizeBy: none
		sourceColumn: As Of

	column 'Person ID External'
		dataType: string
		lineageTag: 46791d5c-4fbd-564d-ba7a-bf6b9c29d99e
		summarizeBy: none
		sourceColumn: Person ID External

